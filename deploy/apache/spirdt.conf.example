# Apache vhost for SPI-RDT.
#
# Copy, replace the three placeholders, and enable it:
#
#   {{ROOT}}        absolute path to the checkout, no trailing slash
#   {{SERVER_NAME}} the hostname you will type, e.g. spirdt.test
#   {{PORT}}        usually 80
#
#   sudo cp deploy/apache/spirdt.conf.example /etc/apache2/sites-available/spirdt.conf
#   sudo a2ensite spirdt && sudo apache2ctl configtest && sudo systemctl reload apache2
#
# There is nothing here but a document root, and that is the point. Both halves
# of the application are served from public/ — the API through index.php, the
# built app through index.html — and public/.htaccess decides which. Keeping the
# rules there rather than here means the deployed artefact carries its own
# routing, so shared hosting works, and a vhost cannot disagree with it.
#
# PHP is not loaded here. A module belongs to the server, not to one site:
# a2enmod php8.4 on Ubuntu, or LoadModule in httpd.conf on macOS. Nothing in
# the application depends on the SAPI, so php-fpm behind mod_proxy_fcgi works
# unchanged.
#
# Checked with apache2ctl configtest (httpd -t on macOS).
# The nginx equivalent is docker/nginx/default.conf.

<VirtualHost *:{{PORT}}>
    ServerName {{SERVER_NAME}}

    DocumentRoot "{{ROOT}}/public"
    DirectoryIndex index.html index.php

    ErrorLog  "/var/log/apache2/spirdt-error.log"
    CustomLog "/var/log/apache2/spirdt-access.log" combined

    <Directory "{{ROOT}}/public">
        # FileInfo would be enough. All is what a stock Ubuntu vhost uses, and
        # matching it means one fewer thing that differs from every other site
        # on the box.
        AllowOverride All
        Require all granted
        Options -Indexes +FollowSymLinks

        # Every route but sign-in carries a Bearer token, so this line decides
        # whether the application works at all. mod_php exposes the header
        # through apache_request_headers(); CGI and FastCGI drop it. The symptom
        # of getting it wrong is that signing in works and every later call
        # returns 401 — which reads as an authentication bug, not a server one.
        CGIPassAuth On
    </Directory>

    # Security headers come from SecurityHeadersMiddleware and from nowhere
    # else. Setting them here as well sends each one twice.
</VirtualHost>

# ─────────────────────────────────────────────
# Permissions
# ─────────────────────────────────────────────
#
# Apache writes logs, caches and uploads under var/, running as www-data — not
# the account that cloned the repository. Skipping this produces an application
# error with nothing in it pointing at permissions:
#
#   sudo chown -R "$USER":www-data {{ROOT}}/var
#   sudo chmod -R g+w {{ROOT}}/var
