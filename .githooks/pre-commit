#!/bin/sh
#
# Fast, local-only gate. Anything slow belongs in CI, not here — a hook that
# takes ten seconds is a hook people bypass.
#
# Enabled repo-wide via core.hooksPath=.githooks (set by composer
# post-install / post-update). Bypass once with `git commit --no-verify`.

# Lint every staged PHP file. Catches the parse error before it reaches CI.
staged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.php$' || true)
if [ -n "$staged" ]; then
    for file in $staged; do
        if ! php -l "$file" > /dev/null 2>&1; then
            echo "pre-commit: PHP syntax error in $file" >&2
            php -l "$file" >&2
            exit 1
        fi
    done
fi

# error_log() is banned outside src/Helper/Log.php — it bypasses the
# UidProcessor, so the line lands with no request UID to correlate against.
leaks=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -E '^src/.*\.php$' \
    | grep -v '^src/Helper/Log\.php$' || true)
if [ -n "$leaks" ]; then
    for file in $leaks; do
        if grep -qn 'error_log(' "$file" 2>/dev/null; then
            echo "pre-commit: error_log() in $file — use App\\Helper\\Log instead." >&2
            exit 1
        fi
    done
fi

# The built app under public/ is tracked, so a commit carries both the source
# and what the source compiles to. They only stay in step if they move
# together. Committing front-end source without rebuilding is the one way this
# arrangement fails, and it fails invisibly: the repository looks right, the
# tests pass, and the server keeps serving the previous build.
#
# Comparing file lists rather than rebuilding. A build is several seconds, and
# a hook nobody waits for is a hook everybody bypasses.
frontend=$(git diff --cached --name-only --diff-filter=ACMRD \
    -- web/src web/index.html web/vite.config.ts web/package.json web/package-lock.json \
    | grep -vE '(__tests__/|\.test\.ts$)' || true)
if [ -n "$frontend" ]; then
    built=$(git diff --cached --name-only --diff-filter=ACMRD -- public/assets public/index.html || true)
    if [ -z "$built" ]; then
        echo "pre-commit: web/ source is staged, the build in public/ is not." >&2
        echo "  The tracked build would ship the previous version of the app." >&2
        echo "  Run: npm --prefix web run build, then stage public/" >&2
        echo "  Or --no-verify, if the change genuinely cannot reach the bundle." >&2
        exit 1
    fi
fi

exit 0
