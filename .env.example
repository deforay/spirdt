# ─── Application ───
APP_NAME="SPI-RDT Assessment Platform"
APP_ENV=local              # local | staging | production
APP_DEBUG=true             # MUST be false in production
APP_URL=http://localhost:8080
APP_TZ=UTC

# ─── Multi-tenancy ───
# Controls UI ONLY — whether organisation management is visible.
# It never gates the data model or tenant scoping. Single-tenant
# installs still carry organization_id on every row.
MULTI_TENANT=false

# ─── Database ───
# The app is environment-agnostic — it only reads these values. Switching
# between Docker and a local MySQL is a .env change, never a code change.
#
#   Docker Compose:  DB_HOST=mysql        DB_PORT=3306
#   Local MySQL:     DB_HOST=127.0.0.1    DB_PORT=3306
#
# Use 127.0.0.1 rather than "localhost" for a local server: localhost makes
# PHP try a unix socket, which fails confusingly if the socket path differs
# from what php.ini expects.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=spirdt
DB_USER=spirdt
DB_PASS=change-me

# ─── Auth ───
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_ACCESS_TTL=900              # 15 minutes
# Long refresh TTL is deliberate: an assessor may be offline for days between
# issuing a token and syncing. Token expiry must never destroy local drafts.
JWT_REFRESH_TTL=2592000         # 30 days

# ─── CORS ───
# Comma-separated origins for the assessor PWA and admin builds.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── Uploads ───
# Signatures and photos. Keep in step with docker/php/php.ini and the
# nginx client_max_body_size, or large media fails at the edge.
UPLOAD_MAX_BYTES=10485760       # 10 MB per file
STORAGE_PATH=/var/www/html/var/uploads

# ─── Logging ───
LOG_LEVEL=debug                 # debug | info | notice | warning | error
LOG_RETENTION_DAYS=30

# ─── Docker host ports ───
# Override when a port is already taken locally.
HTTP_PORT=8080
DB_EXPOSED_PORT=3307

# ─── Local review tooling (not read by the app) ───
# Names the CLI that bin/dev/review invokes, and whatever that CLI needs between
# its own name and the prompt — a review subcommand for one, a non-interactive
# flag for another. Both are deliberately empty here so no tool name is
# committed; set them in your own untracked .env, or export them from your
# shell profile.
#
#   REVIEW_AGENT=<the command>
#   REVIEW_AGENT_ARGS=<subcommand or flags, space separated; empty is fine>
REVIEW_AGENT=
REVIEW_AGENT_ARGS=
