#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Environment doctor — checks this machine can actually run the app.
 *
 * Runs identically inside Docker and on a bare host, because the app itself
 * is environment-agnostic: only .env differs between the two. That is the
 * whole point of this script — it tells you which of the two you are pointed
 * at and whether that target is reachable, instead of leaving you to decode
 * a PDO connection error.
 *
 * Checks, in order:
 *   1. PHP version and required extensions
 *   2. vendor/ installed
 *   3. .env present and required keys set
 *   4. var/ directories writable
 *   5. Database reachable, and whether migrations have run
 *
 * Usage:
 *   bin/preflight            run all checks
 *   bin/preflight --quiet    only print failures (for CI / hooks)
 *   bin/preflight --help     print this docblock
 *
 * Exit codes: 0 all passed, 1 one or more failed.
 */

require __DIR__ . '/lib/help.php';
require __DIR__ . '/lib/console.php';
bin_help_if_requested(__FILE__);

$root  = dirname(__DIR__);
$quiet = in_array('--quiet', $argv, true);

const PF_OK   = 'ok';
const PF_WARN = 'warn';
const PF_FAIL = 'fail';

/** @var list<array{status:string,label:string,detail:string}> $results */
$results = [];

function check(string $label, string $status, string $detail = ''): void
{
    global $results;
    $results[] = ['status' => $status, 'label' => $label, 'detail' => $detail];
}

// ─── 1. PHP ───

// 8.4.1 rather than 8.4.0, and the extra digit is not pedantry: the Symfony
// components this application locks — the mailer, and the console and process
// libraries the backup tool brings — refuse to install below it, so 8.4.0 is a
// version where composer install fails rather than one where anything runs.
$phpOk = PHP_VERSION_ID >= 80401;
check(
    'PHP >= 8.4.1',
    $phpOk ? PF_OK : PF_FAIL,
    PHP_VERSION . ($phpOk ? '' : ' — composer.json requires ^8.4.1'),
);

// opcache is deliberately NOT required: it is a performance extension, and
// the PHP CLI ships with it disabled. Nothing here depends on it.
foreach (['pdo_mysql', 'intl', 'zip', 'mbstring', 'bcmath'] as $ext) {
    $has = extension_loaded($ext);
    check(
        "ext-{$ext}",
        $has ? PF_OK : PF_FAIL,
        $has ? '' : ($ext === 'zip' ? 'required by openspout for .xlsx export' : 'required'),
    );
}

// A warning rather than a failure: uploads work without it, they are simply
// stored at the size they arrived at, and a report PDF leaves out the marks it
// cannot composite rather than failing to render.
$hasGd = extension_loaded('gd');
check(
    'ext-gd',
    $hasGd ? PF_OK : PF_WARN,
    $hasGd ? '' : 'photographs stored unresized, and signatures left off report PDFs',
);

// ─── 2. Dependencies ───

$hasVendor = is_file($root . '/vendor/autoload.php');
check('vendor/ installed', $hasVendor ? PF_OK : PF_FAIL, $hasVendor ? '' : 'run: composer install');

if (!$hasVendor) {
    render($results, $quiet);
    exit(1);
}

require $root . '/vendor/autoload.php';

// ─── 3. Configuration ───

$hasEnv = is_file($root . '/.env');
check('.env present', $hasEnv ? PF_OK : PF_FAIL, $hasEnv ? '' : 'run: cp .env.example .env');

if ($hasEnv) {
    Dotenv\Dotenv::createImmutable($root)->safeLoad();
}

$secret = (string) env('JWT_SECRET', '');
check(
    'JWT_SECRET set',
    strlen($secret) >= 32 ? PF_OK : PF_FAIL,
    strlen($secret) >= 32 ? '' : 'generate: php -r "echo bin2hex(random_bytes(32)) . PHP_EOL;"',
);

$appEnv   = (string) env('APP_ENV', 'production');
$appDebug = (bool) env('APP_DEBUG', false);
check(
    'APP_DEBUG safe for APP_ENV',
    ($appEnv === 'production' && $appDebug) ? PF_FAIL : PF_OK,
    "APP_ENV={$appEnv} APP_DEBUG=" . ($appDebug ? 'true' : 'false'),
);

// ─── 4. Writable paths ───

// Writable BY THIS PROCESS, which is the user who ran the command. A web
// server runs as its own account — _www, www-data — so a directory that
// passes here can still be unwritable to Apache or nginx, and the failure
// then surfaces as an application error with nothing pointing at permissions.
// The group-write bit is the part that can be checked from here, so it is
// reported rather than assumed.
$groupClosed = [];

foreach (['var/log', 'var/cache', 'var/exports', 'var/uploads'] as $dir) {
    $path = $root . '/' . $dir;
    if (!is_dir($path)) {
        @mkdir($path, 0o775, true);
    }
    $writable = is_dir($path) && is_writable($path);
    check("{$dir} writable", $writable ? PF_OK : PF_FAIL, $writable ? '' : 'check permissions');

    if ($writable && (fileperms($path) & 0o020) === 0) {
        $groupClosed[] = $dir;
    }
}

if ($groupClosed !== []) {
    check(
        'var/ group-writable',
        PF_WARN,
        'not group-writable: ' . implode(', ', $groupClosed)
            . ' — fine for bin/serve, breaks under a web server running as another user',
    );
}

// ─── 4b. The built app ───
//
// The app is built into public/, which is the document root, and committed —
// so this is present in a fresh clone and absent only when somebody has
// cleaned it. A missing build is a blank site rather than a degraded one.
$indexPath = $root . '/public/index.html';
check(
    'app built into public/',
    is_file($indexPath) ? PF_OK : PF_FAIL,
    is_file($indexPath) ? '' : 'run: npm --prefix web run build',
);

// ─── 5. Database ───

$host = (string) env('DB_HOST', '127.0.0.1');
$port = (string) env('DB_PORT', '3306');
$name = (string) env('DB_NAME', 'spirdt');

// Naming the target explicitly is the point: "mysql" means you are pointed
// at the Compose service, "127.0.0.1" at a local server. Getting this wrong
// is the single most common reason the app appears broken.
$target = $host === 'mysql' ? 'Docker Compose service' : 'local/remote server';
check('DB target', PF_OK, "{$host}:{$port}/{$name} ({$target})");

try {
    $pdo = new PDO(
        sprintf('mysql:host=%s;port=%s;dbname=%s;charset=utf8mb4', $host, $port, $name),
        (string) env('DB_USER', 'root'),
        (string) env('DB_PASS', ''),
        [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION, PDO::ATTR_TIMEOUT => 5],
    );
    check('DB reachable', PF_OK);

    $version = null;
    try {
        $stmt = $pdo->query("SELECT value FROM system_config WHERE `key` = 'app_version'");
        $version = $stmt === false ? null : ($stmt->fetchColumn() ?: null);
    } catch (PDOException) {
        // system_config absent — migrations have never run here.
    }

    check(
        'Schema migrated',
        $version === null ? PF_WARN : PF_OK,
        $version === null ? 'no schema yet — run: composer migrate' : "version {$version}",
    );

    /**
     * A role holding no permissions can reach nothing, and the gate has no
     * fallback to the role's name — deliberately, so that revoking the last
     * permission means what it says.
     *
     * The failure that produces is silent and total: everybody in the
     * organisation signs in successfully and every screen refuses them. It
     * cannot happen through the application, only through a database restored
     * from before 0.1.15 or a migration that was skipped, and in both cases
     * this is the one place anybody would think to look.
     */
    try {
        $orphans = $pdo->query(
            'SELECT COUNT(*) FROM roles r
             LEFT JOIN role_permissions p ON p.role_id = r.id
             WHERE p.role_id IS NULL AND r.`key` <> "site_user"',
        );

        $count = $orphans === false ? 0 : (int) $orphans->fetchColumn();

        check(
            'Roles have permissions',
            $count === 0 ? PF_OK : PF_WARN,
            $count === 0 ? '' : "{$count} role(s) grant nothing — run: composer migrate",
        );
    } catch (PDOException) {
        // No roles table yet. The schema check above already said so.
    }
} catch (PDOException $e) {
    check('DB reachable', PF_FAIL, $e->getMessage());

    $remedy = con_db_remedy($host, $e);

    if ($remedy !== '') {
        check('DB fix', PF_WARN, $remedy);
    }
}

render($results, $quiet);

$failed = array_filter($results, static fn (array $r): bool => $r['status'] === PF_FAIL);
exit($failed === [] ? 0 : 1);

/**
 * Usable terminal width, falling back to 100 where nothing will say.
 *
 * COLUMNS is a shell variable and is usually not exported to child processes,
 * so tput is what actually answers on a real terminal. Both are checked
 * because tput is absent in some minimal container images.
 */
function terminal_width(): int
{
    static $width = null;

    if ($width !== null) {
        return $width;
    }

    $env = (int) getenv('COLUMNS');

    if ($env > 0) {
        return $width = $env;
    }

    [$out, $code] = con_run('tput cols');
    $reported     = (int) trim($out);

    return $width = ($code === 0 && $reported > 0) ? $reported : 100;
}

/** @param list<array{status:string,label:string,detail:string}> $results */
function render(array $results, bool $quiet): void
{
    $tty    = stream_isatty(STDOUT);
    $green  = $tty ? "\033[32m" : '';
    $yellow = $tty ? "\033[33m" : '';
    $red    = $tty ? "\033[31m" : '';
    $dim    = $tty ? "\033[2m" : '';
    $reset  = $tty ? "\033[0m" : '';

    $counts = [PF_OK => 0, PF_WARN => 0, PF_FAIL => 0];

    foreach ($results as $r) {
        $counts[$r['status']]++;

        if ($quiet && $r['status'] === PF_OK) {
            continue;
        }

        [$mark, $colour] = match ($r['status']) {
            PF_OK   => ['PASS', $green],
            PF_WARN => ['WARN', $yellow],
            default => ['FAIL', $red],
        };

        // 2 spaces + 4-char mark + 2 spaces + 26-char label + 1 space.
        $gutter = 35;
        $detail = $r['detail'];

        // A remedy runs to several lines, and left alone the terminal breaks
        // it mid-word at the right edge with the continuation starting at
        // column 0 — which reads as a separate finding rather than the rest of
        // this one. Every line is indented to the detail column so the block
        // holds together.
        //
        // The author's own line breaks are honoured either way; only the
        // width-driven wrapping is skipped when not attached to a terminal,
        // since piped output is being grepped or pasted into a ticket and a
        // break inserted mid-sentence hides that sentence from a search.
        if ($detail !== '') {
            $usable = $tty ? terminal_width() - $gutter : 0;
            $lines  = [];

            // Split on the author's own line breaks first, then wrap each one.
            // wordwrap() counts from the start of the whole string rather than
            // resetting at an embedded newline, so handing it a multi-line
            // remedy wraps the later lines in the wrong places.
            foreach (explode("\n", $detail) as $line) {
                // An indented line is a command to be copied. Never hard-wrap
                // one: the terminal soft-wraps it and it still copies as a
                // single line, whereas a real newline in the middle of it
                // copies as two and runs as neither.
                $wrap = $usable > 20 && !str_starts_with($line, ' ');

                foreach ($wrap ? explode("\n", wordwrap($line, $usable, "\n", false)) : [$line] as $part) {
                    $lines[] = $part;
                }
            }

            $detail = implode("\n" . str_repeat(' ', $gutter), $lines);
        }

        printf(
            "  %s%s%s  %-26s %s%s%s\n",
            $colour,
            $mark,
            $reset,
            $r['label'],
            $dim,
            $detail,
            $reset,
        );
    }

    printf(
        "\n  %d passed, %d warning(s), %d failed\n",
        $counts[PF_OK],
        $counts[PF_WARN],
        $counts[PF_FAIL],
    );
}
