#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Migration runner for the SPI-RDT Assessment Platform.
 *
 * Plain SQL migrations versioned as semver.
 * Reads files from /migrations/, compares against DB version in system_config.
 *
 * Uses PhpMyAdmin\SqlParser to split statements (handles triggers, procedures,
 * string literals containing semicolons, etc.) and routes common DDL through
 * idempotent helpers that check information_schema before executing.
 *
 * Usage:
 *   php bin/migrate              — run pending migrations
 *   php bin/migrate --status     — show current version and pending files
 *   php bin/migrate --dry-run    — show what would run, no execution
 *   php bin/migrate --verbose    — print info on benign skips
 *
 * Env:
 *   MIG_REPLACE_PK=1   — force dropping/recreating differing primary keys
 */

require __DIR__ . '/lib/help.php';
bin_help_if_requested(__FILE__);

// NOTE: bin/migrate does NOT use bin/lib/bootstrap.php — it's the schema
// runner and runs before Eloquent's expected tables exist. Stays on raw PDO.
require __DIR__ . '/../vendor/autoload.php';

use App\Helper\MigrationErrorClassifier;
use Composer\Semver\Comparator;
use PhpMyAdmin\SqlParser\Parser;

$dotenv = Dotenv\Dotenv::createImmutable(dirname(__DIR__));
$dotenv->load();

$dsn = sprintf(
    'mysql:host=%s;port=%s;dbname=%s;charset=utf8mb4',
    env('DB_HOST', '127.0.0.1'),
    env('DB_PORT', '3306'),
    env('DB_NAME', 'spirdt')
);

try {
    $pdo = new PDO($dsn, env('DB_USER', 'root'), env('DB_PASS', ''), [
        PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
        PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    ]);
} catch (PDOException $e) {
    fwrite(STDERR, "Database connection failed: {$e->getMessage()}\n");
    exit(1);
}

const MIG_NOT_HANDLED = 0;
const MIG_EXECUTED = 1;
const MIG_SKIPPED = 2;

// Warn-vs-fail classification now lives in App\Helper\MigrationErrorClassifier
// so it can be unit-tested. Crucially: 1054 (Unknown column) and 1146 (Unknown
// table) are warns ONLY when the statement is ALTER … CHANGE / MODIFY / RENAME
// / DROP, DROP TABLE, or RENAME TABLE — the idempotent-DDL family. On INSERT /
// UPDATE / DELETE / SELECT, those codes mean a typo and FAIL. This caught the
// 1.5.221 silent failure where `category` should have been `module` and the
// gateway-audit permission row never landed despite app_version advancing.

$args = getopt('', ['status', 'dry-run', 'verbose', 'version:']);
$showStatus = isset($args['status']);
$dryRun = isset($args['dry-run']);
$verbose = isset($args['verbose']) || (bool) getenv('MIG_VERBOSE');
$fromVersion = $args['version'] ?? null;

/* ---------------------- Idempotent DDL helpers ---------------------- */

function current_db(PDO $pdo): string
{
    static $dbName = null;
    if ($dbName === null) {
        $stmt = $pdo->query('SELECT DATABASE() AS db');
        $dbName = (string) ($stmt->fetch()['db'] ?? '');
    }
    return $dbName;
}

function column_exists(PDO $pdo, string $table, string $column): bool
{
    $stmt = $pdo->prepare(
        "SELECT 1 FROM information_schema.COLUMNS
         WHERE TABLE_SCHEMA=? AND TABLE_NAME=? AND COLUMN_NAME=? LIMIT 1"
    );
    $stmt->execute([current_db($pdo), $table, $column]);
    return (bool) $stmt->fetchColumn();
}

function index_exists(PDO $pdo, string $table, string $index): bool
{
    $stmt = $pdo->prepare(
        "SELECT 1 FROM information_schema.STATISTICS
         WHERE TABLE_SCHEMA=? AND TABLE_NAME=? AND INDEX_NAME=? LIMIT 1"
    );
    $stmt->execute([current_db($pdo), $table, $index]);
    return (bool) $stmt->fetchColumn();
}

function table_primary_key(PDO $pdo, string $table): array
{
    $stmt = $pdo->prepare(
        "SELECT k.COLUMN_NAME
         FROM information_schema.TABLE_CONSTRAINTS t
         JOIN information_schema.KEY_COLUMN_USAGE k
           ON t.CONSTRAINT_NAME = k.CONSTRAINT_NAME
          AND t.TABLE_SCHEMA   = k.TABLE_SCHEMA
          AND t.TABLE_NAME     = k.TABLE_NAME
         WHERE t.TABLE_SCHEMA = ?
           AND t.TABLE_NAME   = ?
           AND t.CONSTRAINT_TYPE = 'PRIMARY KEY'
         ORDER BY k.ORDINAL_POSITION"
    );
    $stmt->execute([current_db($pdo), $table]);
    return array_map(
        static fn($r) => strtolower(trim((string) $r['COLUMN_NAME'])),
        $stmt->fetchAll()
    );
}

function parse_cols_list(string $list): array
{
    $parts = preg_split('/\s*,\s*/', trim($list)) ?: [];
    return array_map(static function ($c) {
        $c = trim($c, " \t\r\n`");
        $c = preg_replace('/\s*\(\s*\d+(?:\s*,\s*\d+)?\s*\)\s*/', '', $c);
        $c = preg_replace('/\s+(ASC|DESC)\b/i', '', $c);
        return strtolower($c);
    }, $parts);
}

function add_column_if_missing(PDO $pdo, string $table, string $column, string $ddl): int
{
    if (column_exists($pdo, $table, $column)) {
        return MIG_SKIPPED;
    }
    $pdo->exec($ddl);
    return MIG_EXECUTED;
}

function add_index_if_missing(PDO $pdo, string $table, string $index, string $ddl): int
{
    if (index_exists($pdo, $table, $index)) {
        return MIG_SKIPPED;
    }
    $pdo->exec($ddl);
    return MIG_EXECUTED;
}

function drop_column_if_exists(PDO $pdo, string $table, string $column): int
{
    if (!column_exists($pdo, $table, $column)) {
        return MIG_SKIPPED;
    }

    // MySQL refuses DROP COLUMN if any index or foreign key still references
    // the column (error 1072 "Key column doesn't exist in table"). Hand-rolled
    // migrations don't always remember to drop those first — and even when
    // they do, an EARLIER migration may have added a multi-column key over
    // this column that the column-drop migration didn't anticipate. Sweep
    // those references first so the drop always succeeds.

    $db = current_db($pdo);

    // 1. Drop any FK constraints that include this column on the SOURCE side.
    //    (FKs where this column is the referenced parent are intentionally
    //    not auto-dropped — that would silently break referential integrity
    //    in unrelated tables. The schema author should explicitly handle
    //    those.)
    $stmt = $pdo->prepare(
        "SELECT DISTINCT CONSTRAINT_NAME
         FROM information_schema.KEY_COLUMN_USAGE
         WHERE TABLE_SCHEMA=? AND TABLE_NAME=? AND COLUMN_NAME=?
           AND REFERENCED_TABLE_NAME IS NOT NULL"
    );
    $stmt->execute([$db, $table, $column]);
    foreach ($stmt->fetchAll(PDO::FETCH_COLUMN) as $fkName) {
        $pdo->exec("ALTER TABLE `{$table}` DROP FOREIGN KEY `{$fkName}`");
    }

    // 2. Drop any non-PRIMARY indexes that include this column. PRIMARY is
    //    skipped so we don't silently drop the table's primary key — if
    //    someone is dropping a PK column they should do it explicitly.
    $stmt = $pdo->prepare(
        "SELECT DISTINCT INDEX_NAME
         FROM information_schema.STATISTICS
         WHERE TABLE_SCHEMA=? AND TABLE_NAME=? AND COLUMN_NAME=?
           AND INDEX_NAME != 'PRIMARY'"
    );
    $stmt->execute([$db, $table, $column]);
    foreach ($stmt->fetchAll(PDO::FETCH_COLUMN) as $indexName) {
        $pdo->exec("ALTER TABLE `{$table}` DROP INDEX `{$indexName}`");
    }

    // 3. Now the actual column drop will succeed.
    $pdo->exec("ALTER TABLE `{$table}` DROP `{$column}`");
    return MIG_EXECUTED;
}

function drop_index_if_exists(PDO $pdo, string $table, string $index): int
{
    if (!index_exists($pdo, $table, $index)) {
        return MIG_SKIPPED;
    }
    $pdo->exec("ALTER TABLE `{$table}` DROP INDEX `{$index}`");
    return MIG_EXECUTED;
}

function foreign_key_exists(PDO $pdo, string $table, string $constraint): bool
{
    $stmt = $pdo->prepare(
        "SELECT 1 FROM information_schema.TABLE_CONSTRAINTS
         WHERE TABLE_SCHEMA=? AND TABLE_NAME=? AND CONSTRAINT_NAME=?
           AND CONSTRAINT_TYPE='FOREIGN KEY' LIMIT 1"
    );
    $stmt->execute([current_db($pdo), $table, $constraint]);
    return (bool) $stmt->fetchColumn();
}

function drop_foreign_key_if_exists(PDO $pdo, string $table, string $constraint): int
{
    if (!foreign_key_exists($pdo, $table, $constraint)) {
        return MIG_SKIPPED;
    }
    $sql = "ALTER TABLE `{$table}` DROP FOREIGN KEY `{$constraint}`";
    $pdo->query($sql);
    return MIG_EXECUTED;
}

function apply_change_column(PDO $pdo, string $table, string $oldCol, string $newCol, string $ddl): int
{
    // ALTER TABLE … CHANGE [COLUMN] `old` `new` <coldef> renames old->new and
    // may also retype it. Idempotency hinges on which column is present:
    //
    //   - `old` present  -> run it. Either the rename hasn't applied yet, or
    //     old===new (a pure retype with no rename), which is harmless to
    //     re-run since CHANGE to the same definition is a no-op in MySQL.
    //   - `old` absent, `new` present -> already applied; skip cleanly. This
    //     is the retried-partial-deploy case that previously only survived as
    //     a 1054 WARN.
    //   - neither present -> fall through to the normal error path so a 1054
    //     surfaces (warned for this statement shape via the classifier). We
    //     can't safely guess intent when both ends are missing.
    if (column_exists($pdo, $table, $oldCol)) {
        $pdo->exec($ddl);
        return MIG_EXECUTED;
    }
    if (strcasecmp($oldCol, $newCol) !== 0 && column_exists($pdo, $table, $newCol)) {
        return MIG_SKIPPED;
    }
    return MIG_NOT_HANDLED;
}

function apply_add_primary_key(PDO $pdo, string $table, string $colsList, string $originalSql): int
{
    $wantedCols = parse_cols_list($colsList);
    $haveCols = table_primary_key($pdo, $table);

    if ($haveCols === []) {
        $pdo->exec($originalSql);
        return MIG_EXECUTED;
    }
    if ($haveCols === $wantedCols) {
        return MIG_SKIPPED;
    }

    if (getenv('MIG_REPLACE_PK')) {
        $pdo->exec("ALTER TABLE `{$table}` DROP PRIMARY KEY");
        $colsSql = implode(',', array_map(static fn($c): string => "`{$c}`", $wantedCols));
        $pdo->exec("ALTER TABLE `{$table}` ADD PRIMARY KEY ({$colsSql})");
        return MIG_EXECUTED;
    }

    return MIG_SKIPPED;
}

/**
 * Route known DDL patterns through idempotent helpers.
 * Returns MIG_EXECUTED / MIG_SKIPPED if handled, MIG_NOT_HANDLED to fall through.
 */
function handle_idempotent_ddl(PDO $pdo, string $query): int
{
    $q = trim($query);

    if (preg_match('/^alter\s+table\s+`?([a-z0-9_]+)`?\s+add\s+(?:column\s+)?`?([a-z0-9_]+)`?\s+/i', $q, $m)) {
        $kw = strtolower($m[2]);
        if (!in_array($kw, ['index', 'key', 'primary', 'constraint', 'unique', 'fulltext', 'spatial', 'foreign'], true)) {
            return add_column_if_missing($pdo, $m[1], $m[2], $q);
        }
    }

    if (preg_match('/^create\s+(unique\s+)?index\s+`?([^`\s]+)`?\s*(?:using\s+btree)?\s+on\s+`?([^`\s(]+)`?\s*\((.+?)\)\s*(?:using\s+btree)?\s*;?$/is', $q, $m)) {
        return add_index_if_missing($pdo, $m[3], $m[2], $q);
    }

    if (preg_match('/^alter\s+table\s+`?([a-z0-9_]+)`?\s+add\s+(unique\s+)?index\s+`?([a-z0-9_]+)`?\s*\((.+)\)\s*;?$/is', $q, $m)) {
        $ddl = sprintf('CREATE %sINDEX `%s` ON `%s` (%s)', empty($m[2]) ? '' : 'UNIQUE ', $m[3], $m[1], trim($m[4]));
        return add_index_if_missing($pdo, $m[1], $m[3], $ddl);
    }

    if (preg_match('/^alter\s+table\s+`?([a-z0-9_]+)`?\s+add\s+(unique\s+)?key\s+`?([a-z0-9_]+)`?\s*\((.+)\)\s*;?$/is', $q, $m)) {
        $ddl = sprintf('CREATE %sINDEX `%s` ON `%s` (%s)', empty($m[2]) ? '' : 'UNIQUE ', $m[3], $m[1], trim($m[4]));
        return add_index_if_missing($pdo, $m[1], $m[3], $ddl);
    }

    // CHANGE [COLUMN] `old` `new` <coldef> — rename (and optional retype).
    // Pre-checked so a retried deploy skips cleanly instead of leaning on the
    // 1054 WARN fallback. MODIFY is intentionally NOT routed here: it never
    // renames, so re-running it is already a harmless no-op at the raw-exec
    // path.
    if (preg_match('/^alter\s+table\s+`?([a-z0-9_]+)`?\s+change\s+(?:column\s+)?`?([a-z0-9_]+)`?\s+`?([a-z0-9_]+)`?\b/i', $q, $m)) {
        return apply_change_column($pdo, $m[1], $m[2], $m[3], $q);
    }

    if (preg_match('/^alter\s+table\s+`?([a-z0-9_]+)`?\s+drop\s+column\s+`?([a-z0-9_]+)`?/i', $q, $m)) {
        return drop_column_if_exists($pdo, $m[1], $m[2]);
    }

    if (preg_match('/^alter\s+table\s+`?([a-z0-9_]+)`?\s+drop\s+index\s+`?([a-z0-9_]+)`?/i', $q, $m)) {
        return drop_index_if_exists($pdo, $m[1], $m[2]);
    }

    if (preg_match('/^alter\s+table\s+`?([a-z0-9_]+)`?\s+drop\s+foreign\s+key\s+`?([a-z0-9_]+)`?/i', $q, $m)) {
        return drop_foreign_key_if_exists($pdo, $m[1], $m[2]);
    }

    // ADD CONSTRAINT <name> FOREIGN KEY (...) REFERENCES ... — skip when
    // a constraint with that name already exists. MySQL would otherwise
    // reject with errno 121 ("duplicate key on write or update"), which
    // is the failure mode that bit a partial 1.5.107 deploy: columns
    // were added, FK was added, but the run was retried and re-creating
    // the same FK raised errno 121.
    if (preg_match('/^alter\s+table\s+`?([a-z0-9_]+)`?\s+add\s+constraint\s+`?([a-z0-9_]+)`?\s+foreign\s+key\b/i', $q, $m)) {
        if (foreign_key_exists($pdo, $m[1], $m[2])) {
            return MIG_SKIPPED;
        }
        $pdo->exec($q);
        return MIG_EXECUTED;
    }

    if (preg_match('/^alter\s+table\s+`?([a-z0-9_]+)`?\s+drop\s+`?([a-z0-9_]+)`?/i', $q, $m)) {
        $kw = strtolower($m[2]);
        // Guard against DROP {FOREIGN KEY|PRIMARY KEY|KEY|CHECK|CONSTRAINT} being
        // mis-read as a column drop; fall through to raw exec for those.
        if (in_array($kw, ['foreign', 'primary', 'key', 'check', 'constraint', 'unique', 'fulltext', 'spatial'], true)) {
            return MIG_NOT_HANDLED;
        }
        return drop_column_if_exists($pdo, $m[1], $m[2]);
    }

    if (preg_match('/^alter\s+table\s+`?([^`\s]+)`?\s+add\s+primary\s+key\s*(?:using\s+btree)?\s*\((.+?)\)\s*(?:using\s+btree)?\s*;?$/is', $q, $m)) {
        return apply_add_primary_key($pdo, $m[1], $m[2], $q);
    }

    if (preg_match('/^alter\s+table\s+`?([^`\s]+)`?\s+add\s+constraint\s+`?[^`]+`?\s+primary\s+key\s*(?:using\s+btree)?\s*\((.+?)\)\s*(?:using\s+btree)?\s*;?$/is', $q, $m)) {
        return apply_add_primary_key($pdo, $m[1], $m[2], $q);
    }

    return MIG_NOT_HANDLED;
}

/* ---------------------- End helpers ---------------------- */

$dbVersion = '0.0.0';
try {
    $stmt = $pdo->query("SELECT value FROM system_config WHERE `key` = 'app_version'");
    $row = $stmt->fetch();
    if ($row) {
        $dbVersion = (string) $row['value'];
    }
} catch (PDOException) {
    // system_config doesn't exist yet — first run
}

echo "Running migrations...\n";
echo "Current DB version: {$dbVersion}\n\n";

$migrationDir = dirname(__DIR__) . '/migrations';

// Schema migrations only. Demo / fixture data lives under db/seeds/demo/ and
// is loaded by bin/dev/seed-demo, decoupled from this runner.
$schemaFiles = glob($migrationDir . '/*.sql') ?: [];

if (!$schemaFiles) {
    echo "No migration files found in {$migrationDir}\n";
    exit(0);
}

$migrations = [];
foreach ($schemaFiles as $file) {
    $basename = basename($file, '.sql');
    if (preg_match('/^(\d+\.\d+\.\d+)(.*)$/', $basename, $m)) {
        $migrations[] = [
            'file' => $file,
            'version' => $m[1],
            'suffix' => $m[2],
            'basename' => $basename,
        ];
    }
}

usort($migrations, function ($a, $b) {
    $vCmp = version_compare($a['version'], $b['version']);
    if ($vCmp !== 0) return $vCmp;
    return strcmp($a['suffix'], $b['suffix']);
});

$startVersion = $fromVersion ?? $dbVersion;
$pending = array_filter(
    $migrations,
    fn($m) => Comparator::greaterThanOrEqualTo($m['version'], $startVersion)
);

if ($showStatus) {
    // For human-readable --status output, "pending" means strictly newer
    // than the current DB version. The internal $pending list keeps the
    // >= filter so an idempotent re-apply (e.g. retried partial deploy)
    // can still walk the current-version file's statements and the DDL
    // handlers no-op each already-applied statement. We only relax that
    // when --from was explicitly passed — the operator is telling us they
    // want to see (and re-apply) from a specific version.
    $reportable = $fromVersion === null
        ? array_filter($pending, fn($m) => version_compare($m['version'], $dbVersion, '>'))
        : $pending;
    echo "Pending migrations:\n";
    if (empty($reportable)) {
        echo "  (none — database is up to date)\n";
    }
    foreach ($reportable as $m) {
        echo "  {$m['basename']}.sql\n";
    }
    exit(0);
}

if (empty($pending)) {
    echo "Database is up to date. Nothing to run.\n";
    // Still stamp DB.app_version to match /VERSION before exiting — the
    // project convention is DB version === file VERSION at all times,
    // including for code/seed-only releases that ship no new migrations.
    // (Earlier fix added the stamp after the migration loop; this branch
    // never reaches the loop, so it needed its own stamp.)
    if (!$dryRun) {
        $versionFile = dirname(__DIR__) . '/VERSION';
        $appVersion = is_readable($versionFile) ? trim((string) file_get_contents($versionFile)) : '';
        if ($appVersion !== '' && $appVersion !== $dbVersion) {
            try {
                $stmt = $pdo->prepare(
                    "INSERT INTO system_config (`key`, value) VALUES ('app_version', ?)
                     ON DUPLICATE KEY UPDATE value = VALUES(value)"
                );
                $stmt->execute([$appVersion]);
                echo "  Stamped DB.app_version: {$dbVersion} -> {$appVersion}\n";
            } catch (PDOException $e) {
                fwrite(STDERR, "Warning: could not persist app_version: {$e->getMessage()}\n");
            }
        }
    }
    exit(0);
}

$totalFiles = 0;
$totalStatements = 0;
$passed = 0;
$skipped = 0;
$warned = 0;
$failed = 0;
$lastVersion = $dbVersion;

foreach ($pending as $m) {
    $totalFiles++;
    echo "[{$m['basename']}.sql]\n";

    $sql = file_get_contents($m['file']);
    $parser = new Parser($sql);

    $statements = [];
    foreach ($parser->statements as $statement) {
        $q = trim($statement->build() ?? '');
        if ($q !== '') {
            $statements[] = $q;
        }
    }

    if ($dryRun) {
        foreach ($statements as $stmt) {
            $preview = substr((string) preg_replace('/\s+/', ' ', $stmt), 0, 80);
            echo "  WOULD RUN  {$preview}...\n";
            $totalStatements++;
        }
        echo "\n";
        continue;
    }

    $filePassed = 0;
    $fileSkipped = 0;
    $fileWarned = 0;
    $fileFailed = 0;

    foreach ($statements as $stmt) {
        $totalStatements++;
        $preview = substr((string) preg_replace('/\s+/', ' ', $stmt), 0, 80);

        try {
            $status = handle_idempotent_ddl($pdo, $stmt);

            if ($status === MIG_SKIPPED) {
                if ($verbose) {
                    echo "  \033[36mSKIP\033[0m  {$preview}\n";
                }
                $skipped++; $fileSkipped++;
                continue;
            }

            if ($status === MIG_EXECUTED) {
                if ($verbose) echo "  \033[32mPASS\033[0m  {$preview}\n";
                $passed++; $filePassed++;
                continue;
            }

            $pdo->exec($stmt);
            if ($verbose) echo "  \033[32mPASS\033[0m  {$preview}\n";
            $passed++; $filePassed++;
        } catch (PDOException $e) {
            $errorCode = (string) ($e->errorInfo[1] ?? '0');

            if (MigrationErrorClassifier::isWarnable($errorCode, $stmt)) {
                if ($verbose) {
                    echo "  \033[33mWARN\033[0m  {$preview}\n";
                    echo "        ({$e->getMessage()})\n";
                }
                $warned++; $fileWarned++;
            } else {
                // Failures always print, regardless of --verbose, so they
                // don't scroll out of view in a long migration run.
                echo "  \033[31mFAIL\033[0m  {$preview}\n";
                echo "        ({$e->getMessage()})\n";
                $failed++; $fileFailed++;
            }
        }
    }

    // Per-file one-line summary in non-verbose mode so the operator can
    // see something happened even when no statements failed.
    if (!$verbose) {
        $bits = [];
        if ($filePassed)  $bits[] = "\033[32m{$filePassed} passed\033[0m";
        if ($fileSkipped) $bits[] = "\033[36m{$fileSkipped} skipped\033[0m";
        if ($fileWarned)  $bits[] = "\033[33m{$fileWarned} warned\033[0m";
        if ($fileFailed)  $bits[] = "\033[31m{$fileFailed} failed\033[0m";
        if ($bits) echo "  " . implode(', ', $bits) . "\n";
    }

    $lastVersion = $m['version'];
    echo "\n";
}

// Stamp system_config.app_version to match the file VERSION, regardless of
// whether any migrations actually ran this invocation. Project convention is
// that DB.app_version === /VERSION at all times (bin/deploy's summary surfaces
// any drift). Releases that ship code/seed-only changes still bump VERSION,
// so we stamp unconditionally here to keep them aligned. Falls back to the
// last applied migration's version if VERSION is missing or unreadable.
$finalVersion = $lastVersion;
if (!$dryRun && $failed === 0) {
    $versionFile = dirname(__DIR__) . '/VERSION';
    $appVersion = is_readable($versionFile) ? trim((string) file_get_contents($versionFile)) : '';
    if ($appVersion === '') {
        $appVersion = $lastVersion;
    }
    try {
        $stmt = $pdo->prepare(
            "INSERT INTO system_config (`key`, value) VALUES ('app_version', ?)
             ON DUPLICATE KEY UPDATE value = VALUES(value)"
        );
        $stmt->execute([$appVersion]);
        $finalVersion = $appVersion;
    } catch (PDOException $e) {
        fwrite(STDERR, "Warning: could not persist app_version: {$e->getMessage()}\n");
    }
}

echo str_repeat('─', 50) . "\n";
if ($dryRun) {
    echo "  DRY RUN — no changes made\n";
} else {
    echo "  DB version:   {$dbVersion} -> {$finalVersion}\n";
}
echo "  Files run:    {$totalFiles}\n";
echo "  Statements:   {$totalStatements}\n";
if (!$dryRun) {
    echo "  Passed:       {$passed}\n";
    echo "  Skipped:      {$skipped}\n";
    echo "  Warned:       {$warned}\n";
    echo "  Failed:       {$failed}\n";
}
echo str_repeat('─', 50) . "\n";

exit($failed > 0 ? 1 : 0);
