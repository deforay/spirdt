#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Put a few facilities and testing sites into an organisation.
 *
 * For local work only. An assessor cannot start a visit without a site to
 * assess, so this puts enough of a registry in place to use the app end to end
 * without filling in the registry screens first.
 *
 * Idempotent: sites are matched by facility and name, so running it twice does
 * not produce a second Kanyama Clinic.
 *
 * Run it without --org and it lists the organisations on this installation and
 * asks which one. The code is not something anybody remembers, and refusing on
 * a missing flag while holding the list is unhelpful on purpose.
 *
 * Usage:
 *   bin/dev/seed-sites                 list the organisations and ask
 *   bin/dev/seed-sites --org=demo
 *   bin/dev/seed-sites --help
 *
 * Exit codes: 0 seeded, 1 refused.
 */

require __DIR__ . '/../lib/help.php';
bin_help_if_requested(__FILE__);
require __DIR__ . '/../lib/console.php';

$root = dirname(__DIR__, 2);
chdir($root);

if (!is_file($root . '/vendor/autoload.php')) {
    con_fail('vendor/ missing — run composer install.');
}

require $root . '/vendor/autoload.php';

use App\Support\BinaryUuid;

/** Facility => its testing sites. */
const REGISTRY = [
    'Kanyama Level 1 Hospital' => ['Kanyama Clinic Laboratory', 'Kanyama ART Corner'],
    'Chilenje Health Centre'   => ['Chilenje Testing Room'],
    'Matero Reference Centre'  => ['Matero Main Laboratory'],
];

$options = [];
foreach (array_slice($argv, 1) as $argument) {
    if (preg_match('/^--([a-z-]+)=(.*)$/', $argument, $matches) === 1) {
        $options[$matches[1]] = $matches[2];
    }
}

// Connected BEFORE anything is asked or refused. The organisation code is the
// one thing this script needs and the only place it can be looked up is here,
// so refusing on a missing --org without having read the list means telling
// somebody they got it wrong while knowing what right would have been.
$env = con_read_env(con_env_path($root));

try {
    $pdo = con_pdo($env, $env['DB_NAME'] ?? 'spirdt');
} catch (PDOException $e) {
    con_print('error', 'Cannot reach the database: ' . $e->getMessage());

    $remedy = con_db_remedy($env['DB_HOST'] ?? '', $e);

    foreach (explode("\n", $remedy === '' ? 'Check DB_HOST, DB_PORT, DB_USER and DB_PASS in .env.' : $remedy) as $line) {
        con_print('info', $line);
    }

    con_fail('Nothing was written.');
}

/**
 * Every organisation, with what it already has.
 *
 * The site count is on the PROGRAMME rather than the organisation, because
 * that is where the registry lives — two organisations sharing a programme
 * share these sites, and seeding either one seeds both. Showing the count per
 * organisation would report the same registry twice and read as two.
 *
 * @return list<array<string,mixed>>
 */
function seed_organizations(PDO $pdo): array
{
    $rows = $pdo->query(
        'SELECT o.id, o.code, o.name, o.programme_id,
                (SELECT COUNT(*) FROM testing_sites t WHERE t.programme_id = o.programme_id) AS sites
         FROM organizations o
         ORDER BY o.code',
    );

    return $rows === false ? [] : $rows->fetchAll(PDO::FETCH_ASSOC);
}

/** @param list<array<string,mixed>> $organizations */
function seed_list(array $organizations): void
{
    con_print('info', 'Organisations on this installation:');

    foreach ($organizations as $organization) {
        $sites = (int) $organization['sites'];

        con_print('info', sprintf(
            '  %-20s %s (%s)',
            (string) $organization['code'],
            (string) $organization['name'],
            $sites === 0 ? 'no sites yet' : $sites . ' testing site' . ($sites === 1 ? '' : 's'),
        ));
    }
}

$organizations = seed_organizations($pdo);

if ($organizations === []) {
    con_print('error', 'There are no organisations to seed into.');
    con_print('info', 'Make one first: bin/dev/create-user --org=demo --email=you@example.org --name="Your Name" --role=admin');

    con_fail('Nothing was written.');
}

$orgCode = trim($options['org'] ?? '');

$byCode = [];
foreach ($organizations as $organization) {
    $byCode[(string) $organization['code']] = (int) $organization['id'];
}

// Asked rather than refused, and asked with the answers in view. A single
// organisation is offered as the default, since on a development machine it
// is nearly always the one meant.
if ($orgCode === '' || !isset($byCode[$orgCode])) {
    if ($orgCode !== '') {
        con_print('error', 'No organisation ' . $orgCode . '.');
    }

    seed_list($organizations);

    if (!con_is_interactive()) {
        con_fail('Pass one of those as --org.');
    }

    $orgCode = trim(con_ask(
        'Organisation code',
        count($organizations) === 1 ? (string) $organizations[0]['code'] : '',
    ));
}

if (!isset($byCode[$orgCode])) {
    con_fail('No organisation ' . ($orgCode === '' ? '(none given)' : $orgCode) . '. Nothing was written.');
}

$organizationId = $byCode[$orgCode];

/** UUIDv7, matching what the devices mint. */
function seed_uuid(): string
{
    $bytes = random_bytes(16);
    $millis = (int) (microtime(true) * 1000);

    for ($i = 5; $i >= 0; --$i) {
        $bytes[$i] = chr($millis & 0xff);
        $millis >>= 8;
    }

    $bytes[6] = chr((ord($bytes[6]) & 0x0f) | 0x70);
    $bytes[8] = chr((ord($bytes[8]) & 0x3f) | 0x80);

    return BinaryUuid::toString($bytes);
}

$created = 0;

// The registry belongs to the programme rather than the organisation, so
// seeding into one organisation seeds it for every organisation sharing that
// programme. That is the point of the layer, and it is why the lookups below
// match on programme_id: matching on organization_id would re-seed a duplicate
// set for the second organisation in the same programme.
$statement = $pdo->prepare('SELECT programme_id FROM organizations WHERE id = ?');
$statement->execute([$organizationId]);
$programmeId = (int) $statement->fetchColumn();

if ($programmeId === 0) {
    con_fail('That organisation has no programme. Run bin/migrate.');
}

foreach (REGISTRY as $facilityName => $siteNames) {
    $statement = $pdo->prepare('SELECT id FROM facilities WHERE programme_id = ? AND name = ?');
    $statement->execute([$programmeId, $facilityName]);
    $facilityId = $statement->fetchColumn();

    if ($facilityId === false) {
        $facilityId = BinaryUuid::toBytes(seed_uuid());

        $pdo->prepare(
            'INSERT INTO facilities (id, programme_id, organization_id, name, source)
             VALUES (?, ?, ?, ?, ?)',
        )->execute([$facilityId, $programmeId, $organizationId, $facilityName, 'registry']);

        con_print('success', 'Facility ' . $facilityName);
    }

    foreach ($siteNames as $siteName) {
        $statement = $pdo->prepare(
            'SELECT id FROM testing_sites WHERE programme_id = ? AND facility_id = ? AND name = ?',
        );
        $statement->execute([$programmeId, $facilityId, $siteName]);

        if ($statement->fetchColumn() !== false) {
            continue;
        }

        $pdo->prepare(
            'INSERT INTO testing_sites (id, programme_id, organization_id, facility_id, name, source)
             VALUES (?, ?, ?, ?, ?, ?)',
        )->execute([
            BinaryUuid::toBytes(seed_uuid()),
            $programmeId,
            $organizationId,
            $facilityId,
            $siteName,
            'registry',
        ]);

        con_print('success', '  ' . $siteName);
        ++$created;
    }
}

con_print('info', $created === 0 ? 'Already seeded.' : $created . ' testing sites added.');
