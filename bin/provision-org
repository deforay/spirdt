#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Onboard a new organisation and its first administrator.
 *
 * This is the operational counterpart to bin/dev/create-user. That script
 * creates a user and will conjure an organisation around it for convenience;
 * this one treats the organisation as the thing being created and asks for the
 * settings that are wrong to default.
 *
 * Timezone and date format matter more than they look. The server clock is UTC
 * and every organisation displays against its own, and the SPI-RDT User's Guide
 * makes date format a per-country customisation point — an assessment dated
 * 05/08/2026 is either August or May depending on who is reading it, and the
 * difference is invisible until someone disputes a certification level.
 *
 * Refuses an organisation code that already exists. Provisioning silently
 * reusing one is how a new administrator ends up inside somebody else's tenant
 * with full access to their assessments.
 *
 * Usage:
 *   bin/provision-org                                  ask for everything
 *   bin/provision-org --code=zm-moh --name="MoH Zambia" \
 *       --admin-email=grace@moh.gov.zm --admin-name="Grace Phiri" \
 *       --country=ZM --timezone=Africa/Lusaka
 *   bin/provision-org --help
 *
 * Options:
 *   --code           Short unique code. Used at sign-in where one address
 *                    exists in more than one organisation. Required.
 *   --name           Display name. Required.
 *   --admin-email    First administrator's sign-in address. Required.
 *   --admin-name     First administrator's full name. Required.
 *   --programme      Join an existing programme by its code, so this
 *                    organisation shares that programme's site registry —
 *                    the case where two organisations audit labs in the same
 *                    country and their results have to be comparable. Omit it
 *                    to get a programme of this organisation's own, which is
 *                    the safe default: assessments stay private either way,
 *                    but a site list should only be shared deliberately.
 *   --country        ISO 3166-1 alpha-2, e.g. ZM.
 *   --timezone       IANA zone, e.g. Africa/Lusaka. Defaults to UTC.
 *   --date-format    PHP date format. Defaults to d/m/Y.
 *   --locale         Defaults to en.
 *   --password       Skips generation. Avoid it — a generated password is
 *                    stronger than one chosen at a terminal, and this one
 *                    opens an entire organisation.
 *
 * Exit codes: 0 provisioned, 1 refused.
 */

require __DIR__ . '/lib/help.php';
bin_help_if_requested(__FILE__);
require __DIR__ . '/lib/console.php';

$root = dirname(__DIR__);
chdir($root);

if (!is_file($root . '/vendor/autoload.php')) {
    con_fail('vendor/ missing — run composer install.');
}

require $root . '/vendor/autoload.php';

/**
 * Reach the database BEFORE asking anything.
 *
 * This used to connect after five questions, so a .env still pointing at the
 * Compose service name — the shipped default — threw an uncaught PDOException
 * with a stack trace, after the operator had typed an organisation name, an
 * email and a full name. The remedy is one line in .env, and nothing about the
 * failure said so.
 *
 * con_db_remedy is the same advice bin/setup gives, so the two agree about what
 * an unreachable database means rather than each guessing.
 */
$env = con_read_env(con_env_path($root));

try {
    $pdo = con_pdo($env, $env['DB_NAME'] ?? 'spirdt');
} catch (PDOException $e) {
    con_print('error', 'Cannot reach the database: ' . $e->getMessage());

    $remedy = con_db_remedy($env['DB_HOST'] ?? '', $e);

    foreach (explode("\n", $remedy === '' ? 'Check DB_HOST, DB_PORT, DB_USER and DB_PASS in .env.' : $remedy) as $line) {
        con_print('info', $line);
    }

    con_fail('Nothing was asked and nothing was written.');
}

/** Seeded for every organisation. is_system marks them undeletable. */
const SYSTEM_ROLES = [
    'superadmin' => 'Superadmin',
    'admin'      => 'Administrator',
    'assessor'   => 'Assessor',
    'viewer'     => 'Viewer',
    'site_user'  => 'Site user',
];

$options = [];
foreach (array_slice($argv, 1) as $argument) {
    if (preg_match('/^--([a-z-]+)=(.*)$/', $argument, $matches) === 1) {
        $options[$matches[1]] = $matches[2];
    }
}

/** Take it from the flag, else ask, else fail — never silently default. */
function required(array $options, string $key, string $question): string
{
    $value = trim($options[$key] ?? '');

    if ($value === '' && con_is_interactive()) {
        $value = trim(con_ask($question));
    }

    if ($value === '') {
        con_fail('--' . $key . ' is required. See --help.');
    }

    return $value;
}

$code = strtolower(required($options, 'code', 'Organisation code (short, no spaces)'));
$name = required($options, 'name', 'Organisation name');
$adminEmail = mb_strtolower(required($options, 'admin-email', 'Administrator email'));
$adminName = required($options, 'admin-name', 'Administrator full name');

if (preg_match('/^[a-z0-9][a-z0-9-]{1,49}$/', $code) !== 1) {
    con_fail('Use lowercase letters, digits and hyphens for the code: ' . $code);
}

if (filter_var($adminEmail, FILTER_VALIDATE_EMAIL) === false) {
    con_fail('That does not look like an email address: ' . $adminEmail);
}

$country = strtoupper(trim($options['country'] ?? ''));

if ($country !== '' && preg_match('/^[A-Z]{2}$/', $country) !== 1) {
    con_fail('Country must be a two-letter ISO code, e.g. ZM.');
}

$timezone = trim($options['timezone'] ?? '') ?: 'UTC';

// Checked here rather than trusted, because a bad zone is not rejected by the
// column — it is stored, and then every date this organisation ever displays is
// computed against a zone that does not exist.
if (!in_array($timezone, DateTimeZone::listIdentifiers(), true)) {
    con_fail('Unknown timezone ' . $timezone . '. Use an IANA name such as Africa/Lusaka.');
}

/**
 * The programme this organisation joins, if it is joining an existing one.
 *
 * A programme owns the site registry — geographic units, facilities, testing
 * sites — so two organisations sharing one are auditing from the same national
 * list, which is what makes their results comparable. Blank means a programme
 * of its own, which is the safe default: their assessments stay private either
 * way, but their site list does not.
 */
$programmeCode = strtolower(trim($options['programme'] ?? ''));

$dateFormat = trim($options['date-format'] ?? '') ?: 'd/m/Y';
$locale = trim($options['locale'] ?? '') ?: 'en';

$password = $options['password'] ?? null;
$generated = false;

if ($password === null) {
    // Base64url of 18 bytes: 24 characters, no ambiguous punctuation to read
    // out over a phone line.
    $password = rtrim(strtr(base64_encode(random_bytes(18)), '+/', '-_'), '=');
    $generated = true;
}

if (strlen($password) < 12) {
    con_fail('Use at least 12 characters.');
}

$statement = $pdo->prepare('SELECT id FROM organizations WHERE code = ?');
$statement->execute([$code]);

if ($statement->fetchColumn() !== false) {
    con_fail(
        'An organisation with the code ' . $code . ' already exists. '
        . 'To add a user to it, use bin/dev/create-user --org=' . $code . '.',
    );
}

$pdo->beginTransaction();

try {
    // A programme of its own unless one was named. Two organisations that
    // should share a site registry is a deliberate decision — defaulting to
    // "same country, same programme" would hand one organisation's national
    // site list to another because they happen to share a border.
    if ($programmeCode === '') {
        $pdo->prepare('INSERT INTO programmes (code, name, country_code) VALUES (?, ?, ?)')
            ->execute([$code, $name, $country === '' ? null : $country]);

        $programmeId = (int) $pdo->lastInsertId();
    } else {
        $statement = $pdo->prepare('SELECT id FROM programmes WHERE code = ?');
        $statement->execute([$programmeCode]);
        $programmeId = (int) $statement->fetchColumn();

        if ($programmeId === 0) {
            con_fail(
                'No programme with the code ' . $programmeCode . '. Omit --programme to create one, '
                . 'or check bin/recover-access --list for the organisations already in it.',
            );
        }
    }

    $pdo->prepare(
        'INSERT INTO organizations (programme_id, code, name, country_code, timezone, date_format, default_locale)
         VALUES (?, ?, ?, ?, ?, ?, ?)',
    )->execute([
        $programmeId,
        $code,
        $name,
        $country === '' ? null : $country,
        $timezone,
        $dateFormat,
        $locale,
    ]);

    $organizationId = (int) $pdo->lastInsertId();

    foreach (SYSTEM_ROLES as $key => $label) {
        $pdo->prepare(
            'INSERT INTO roles (organization_id, `key`, name, is_system) VALUES (?, ?, ?, 1)',
        )->execute([$organizationId, $key, $label]);
    }

    // Standing up a NEW programme makes this person its owner, so they get
    // superadmin: somebody has to be able to add the other organisations that
    // will audit alongside them, and there is otherwise nobody who can.
    // Joining an existing programme makes them an ordinary tenant
    // administrator — that programme already has an owner.
    $firstRole = $programmeCode === '' ? 'superadmin' : 'admin';

    $statement = $pdo->prepare('SELECT id FROM roles WHERE organization_id = ? AND `key` = ?');
    $statement->execute([$organizationId, $firstRole]);
    $roleId = (int) $statement->fetchColumn();

    // must_change_password is set because a password someone else chose should
    // not stay in use. NOTHING ENFORCES IT YET — there is no change-password
    // endpoint — so it is a record of intent rather than a control. Treat the
    // generated password as needing to be changed by hand for now.
    $pdo->prepare(
        'INSERT INTO users
            (organization_id, role_id, email, password_hash, full_name, is_active, must_change_password)
         VALUES (?, ?, ?, ?, ?, 1, 1)',
    )->execute([
        $organizationId,
        $roleId,
        $adminEmail,
        password_hash($password, PASSWORD_DEFAULT),
        $adminName,
    ]);

    $pdo->commit();
} catch (Throwable $e) {
    $pdo->rollBack();
    con_fail('Nothing was written: ' . $e->getMessage());
}

con_print('success', 'Provisioned ' . $name . ' (' . $code . ')');
con_print('info', 'Roles: ' . implode(', ', array_keys(SYSTEM_ROLES)));
con_print('info', 'Dates display as ' . $dateFormat . ' in ' . $timezone);

// An organisation with no published instrument cannot receive a single
// assessment, and the failure surfaces as a refused sync days later.
$statement = $pdo->prepare(
    "SELECT COUNT(*) FROM templates WHERE status = 'published' AND org_key IN (0, ?)",
);
$statement->execute([$organizationId]);

if ((int) $statement->fetchColumn() === 0) {
    con_print('warn', 'No published template. Run bin/dev/publish-template or syncing will be refused.');
}

con_print('header', 'Administrator');
con_print('info', 'Email:    ' . $adminEmail);

if ($generated) {
    con_print('info', 'Password: ' . $password);
    con_print('warn', 'Shown once. It is stored hashed and cannot be read back.');
}
