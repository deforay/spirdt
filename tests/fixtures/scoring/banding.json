{
    "why": "Percentage arithmetic and band selection on their own, with no template in the way. The band boundaries are where a certification dispute happens, so each one is pinned from both sides.",
    "bands": [
        { "level": 0, "min_percent": 0 },
        { "level": 1, "min_percent": 40 },
        { "level": 2, "min_percent": 60 },
        { "level": 3, "min_percent": 80 },
        { "level": 4, "min_percent": 90 }
    ],
    "cases": [
        {
            "score": 0,
            "possible": 100,
            "round_dp": 2,
            "expect": { "percentage": 0.0, "level": 0 },
            "why": "a site that scores nothing is Level 0, not unbanded"
        },
        {
            "score": 39,
            "possible": 100,
            "round_dp": 2,
            "expect": { "percentage": 39.0, "level": 0 },
            "why": "just below the Level 1 boundary"
        },
        {
            "score": 40,
            "possible": 100,
            "round_dp": 2,
            "expect": { "percentage": 40.0, "level": 1 },
            "why": "exactly on the boundary belongs to the higher band"
        },
        {
            "score": 59,
            "possible": 100,
            "round_dp": 2,
            "expect": { "percentage": 59.0, "level": 1 }
        },
        {
            "score": 60,
            "possible": 100,
            "round_dp": 2,
            "expect": { "percentage": 60.0, "level": 2 }
        },
        {
            "score": 79,
            "possible": 100,
            "round_dp": 2,
            "expect": { "percentage": 79.0, "level": 2 }
        },
        {
            "score": 80,
            "possible": 100,
            "round_dp": 2,
            "expect": { "percentage": 80.0, "level": 3 }
        },
        {
            "score": 89,
            "possible": 100,
            "round_dp": 2,
            "expect": { "percentage": 89.0, "level": 3 }
        },
        {
            "score": 90,
            "possible": 100,
            "round_dp": 2,
            "expect": { "percentage": 90.0, "level": 4 },
            "why": "the certification boundary: 90% is eligible"
        },
        {
            "score": 100,
            "possible": 100,
            "round_dp": 2,
            "expect": { "percentage": 100.0, "level": 4 }
        },
        {
            "score": 17999,
            "possible": 20000,
            "round_dp": 2,
            "expect": { "percentage": 90.0, "level": 4 },
            "why": "89.995 exactly. Rounding happens BEFORE banding, so this reaches 90.00 and certifies. Banding the unrounded value would return Level 3, and the whole reason the rounding order is specified is that this case decides a certification."
        },
        {
            "score": 17998,
            "possible": 20000,
            "round_dp": 2,
            "expect": { "percentage": 89.99, "level": 3 },
            "why": "the value immediately below, to prove the case above is rounding rather than the comparison being loose"
        },
        {
            "score": 7999,
            "possible": 20000,
            "round_dp": 2,
            "expect": { "percentage": 40.0, "level": 1 },
            "why": "39.995 exactly — the same midpoint rule at the bottom of the scale, where it lifts a site out of Level 0"
        },
        {
            "score": 3999,
            "possible": 10000,
            "round_dp": 2,
            "expect": { "percentage": 39.99, "level": 0 },
            "why": "39.99 does not reach 40 and must not be nudged there"
        },
        {
            "score": 168,
            "possible": 206,
            "round_dp": 2,
            "expect": { "percentage": 81.55, "level": 3 },
            "why": "the worked example in docs/scoring.md"
        },
        {
            "score": 1,
            "possible": 3,
            "round_dp": 2,
            "expect": { "percentage": 33.33, "level": 0 },
            "why": "a repeating fraction rounds down"
        },
        {
            "score": 2,
            "possible": 3,
            "round_dp": 2,
            "expect": { "percentage": 66.67, "level": 2 },
            "why": "and the same fraction rounds up in the other direction"
        },
        {
            "score": 2,
            "possible": 3,
            "round_dp": 0,
            "expect": { "percentage": 67.0, "level": 2 },
            "why": "round_dp is template data, so the arithmetic has to hold at other precisions"
        },
        {
            "score": 0,
            "possible": 0,
            "round_dp": 2,
            "expect": { "percentage": null, "level": null },
            "why": "an assessment where every applicable question came back Not Applicable. No division, no NaN, and no Level 0 — an unscorable assessment is not a failing one."
        }
    ]
}
