# Apache configuration for the BUILT app.
#
# Lives in web/public/, which Vite copies verbatim into web/dist/ on every
# build — so it is part of the artefact rather than something to remember. The
# vhost in deploy/apache/ carries the same rules; this is what makes the app
# work under a vhost generated by a tool that only knows about one document
# root, and on shared hosting where there is no vhost to edit.
#
# It takes effect wherever AllowOverride is at least FileInfo.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # An unknown path is a screen in the app, not a missing file. Without this,
    # reloading on any screen but the first returns 404 — and a reload is
    # exactly what somebody does when a screen looks wrong.
    #
    # The first two conditions are what stop the rule feeding itself. The
    # file/directory tests below are only a terminator while /index.html
    # resolves, and a document root pointing anywhere but this directory is
    # enough to break that: the rewrite target then matches the rule again and
    # Apache gives up after ten passes with "Request exceeded the limit of 10
    # internal redirects", naming no rule and no file.
    RewriteCond %{REQUEST_URI} !^/index\.html$

    # The API is aliased in beneath this document root and is served from
    # elsewhere. It must never be answered with the app's HTML — a JSON client
    # receiving a page is a parse error a long way from its cause.
    RewriteCond %{REQUEST_URI} !^/api(/|$)

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ /index.html [L]
</IfModule>

# Fingerprinted filenames: a changed file is a changed URL, so a year is safe
# for as long as the build keeps hashing. index.html is deliberately excluded —
# it is the one file whose name never changes and whose contents always do.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2?|png|svg|jpg|jpeg|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
